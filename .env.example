# The local screening workspace needs no provider keys.
DATABASE_URL="postgresql://user:password@localhost:5432/au_partimer?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Optional grounded agent explanation. Rules and retrieval work without this key.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional ABN Lookup web services GUID (not an identity guarantee)
ABN_LOOKUP_GUID=""

# Production online services require a random token of at least 32 characters.
APP_ACCESS_TOKEN=""
ENABLE_REMOTE_BACKUP="false"
# Exactly 64 hex characters; keep separate from database backups.
CASE_ENCRYPTION_KEY=""
